# Copy to .env locally; do not commit .env or reuse the real local database credentials.
# Required: generate two DIFFERENT long passwords before running Compose.
SAFEWORK_MYSQL_PASSWORD=
SAFEWORK_MYSQL_ROOT_PASSWORD=

# The existing application uses 8080; this isolated instance uses 8081 by default.
SAFEWORK_HTTP_PORT=8081

# Optional ONE-TIME platform administrator provisioning, disabled by default.
# Fill only for the initial start, then set false and REMOVE the five values.
SAFEWORK_CREAR_ADMIN_PLATAFORMA=false
SAFEWORK_PLATFORM_USERNAME=
SAFEWORK_PLATFORM_PASSWORD=
SAFEWORK_PLATFORM_NOMBRE=
SAFEWORK_PLATFORM_APELLIDO=
SAFEWORK_PLATFORM_CORREO=

# Opcionales. Mantener false en el piloto local sin HTTPS/SMTP/pasarela.
SAFEWORK_PUBLIC_URL=
SAFEWORK_HTTPS=false
SAFEWORK_RECUPERACION_ENABLED=false
SAFEWORK_MAIL_FROM=
SAFEWORK_SMTP_HOST=
SAFEWORK_SMTP_PORT=587
SAFEWORK_SMTP_USERNAME=
SAFEWORK_SMTP_PASSWORD=
SAFEWORK_PAGOS_ENABLED=false
SAFEWORK_MP_TEST_ACCESS_TOKEN=
SAFEWORK_MP_TEST_SELLER_ID=0
SAFEWORK_MP_WEBHOOK_SECRET=
