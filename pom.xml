<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Versión del modelo utilizado por Maven -->
    <modelVersion>4.0.0</modelVersion>


    <!--
        Spring Boot será el proyecto padre.
        Nos permite administrar automáticamente
        las versiones compatibles de las dependencias.
    -->
    <parent>

        <groupId>org.springframework.boot</groupId>

        <artifactId>spring-boot-starter-parent</artifactId>

        <version>4.1.1</version>

        <relativePath/>

    </parent>


    <!-- Identificador de nuestro proyecto -->
    <groupId>com.safework</groupId>

    <!-- Nombre del proyecto -->
    <artifactId>safework</artifactId>

    <!-- Versión actual del proyecto -->
    <version>0.0.1-SNAPSHOT</version>

    <!-- Nombre del proyecto -->
    <name>safework</name>

    <description/>


    <!-- Información adicional del proyecto -->
    <url/>

    <licenses>
        <license/>
    </licenses>

    <developers>
        <developer/>
    </developers>

    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>


    <!--
        Configuración general del proyecto.

        Indicamos que utilizaremos Java 21.
    -->
    <properties>

        <java.version>21</java.version>

    </properties>


    <!--
        Aquí se encuentran todas las dependencias
        que necesita SafeWork.
    -->
    <dependencies>


        <!--
            ACTUATOR

            Permite obtener información relacionada
            con el estado y funcionamiento de
            la aplicación Spring Boot.
        -->
        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-actuator</artifactId>

        </dependency>


        <!--
            THYMELEAF

            Motor de plantillas utilizado para crear
            páginas HTML dinámicas.

            Permite utilizar:

            th:text
            th:each
            th:field
            th:href
            th:action
            etc.
        -->
        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-thymeleaf</artifactId>

        </dependency>


        <!--
            SPRING WEB MVC

            Permite crear la aplicación web.

            Gracias a esta dependencia podemos utilizar:

            @Controller
            @GetMapping
            @PostMapping
            @PathVariable
            @ModelAttribute
            Model
            etc.
        -->
        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-webmvc</artifactId>

        </dependency>


        <!--
            SPRING DATA JPA

            Permite trabajar con persistencia
            utilizando entidades y repositorios.

            Gracias a esta dependencia podemos utilizar:

            @Entity
            @Table
            @Id
            @GeneratedValue
            @Column

            y repositorios como JpaRepository.

            Spring utiliza Hibernate como ORM
            para realizar gran parte del trabajo
            relacionado con la base de datos.
        -->
        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-data-jpa</artifactId>

        </dependency>


        <!--
            MYSQL CONNECTOR/J

            Driver que permite que Java pueda
            comunicarse con MySQL.

            Esta dependencia participa en la conexión:

            Spring Boot
                ↓
            JPA / Hibernate
                ↓
            MySQL Connector/J
                ↓
            MySQL
        -->
        <dependency>

            <groupId>com.mysql</groupId>

            <artifactId>mysql-connector-j</artifactId>

            <scope>runtime</scope>

        </dependency>


        <!--
            VALIDATION

            Permite validar los datos antes
            de almacenarlos.

            Gracias a esta dependencia podremos utilizar:

            @NotBlank
            @Size
            @Valid

            entre otras validaciones.
        -->
        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-validation</artifactId>

        </dependency>


        <!--
            DEVTOOLS

            Herramienta de apoyo durante
            el desarrollo.

            Facilita el reinicio automático
            de Spring Boot cuando realizamos
            determinados cambios en el código.
        -->
        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-devtools</artifactId>

            <scope>runtime</scope>

            <optional>true</optional>

        </dependency>


        <!--
            DEPENDENCIA PARA PRUEBAS DE THYMELEAF

            Se utiliza únicamente durante
            las pruebas automatizadas.
        -->
        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-thymeleaf-test</artifactId>

            <scope>test</scope>

        </dependency>


        <!--
            DEPENDENCIA PARA PRUEBAS DE SPRING MVC

            Se utiliza únicamente durante
            las pruebas automatizadas.
        -->
        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-webmvc-test</artifactId>

            <scope>test</scope>

        </dependency>


    </dependencies>


    <!--
        Configuración utilizada por Maven
        para construir nuestra aplicación.
    -->
    <build>

        <plugins>


            <!--
                Plugin oficial de Spring Boot.

                Permite empaquetar y ejecutar
                correctamente la aplicación.
            -->
            <plugin>

                <groupId>org.springframework.boot</groupId>

                <artifactId>spring-boot-maven-plugin</artifactId>

            </plugin>


        </plugins>

    </build>


</project>